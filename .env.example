ENVIRONMENT=prod

POSTGRES_PASSWORD=replace-with-strong-database-password

DATABASE_URL=postgresql://postgres:replace-with-strong-database-password@postgres:5432/access_poc
REDIS_URL=redis://redis:6379/0

ADMIN_API_KEY=replace-with-random-admin-api-key
JWT_SECRET=replace-with-random-jwt-secret-at-least-32-bytes

JWT_ACTIVE_KID=v2
JWT_KEYRING_JSON={"v1":"replace-with-old-signing-key-at-least-32-bytes","v2":"replace-with-new-signing-key-at-least-32-bytes"}

SECRET_ENCRYPTION_KEY=replace-with-32-byte-secret
IP_HASH_PEPPER=replace-with-random-ip-hash-pepper
WEBHOOK_SECRET_PEPPER=replace-with-random-webhook-pepper

UVICORN_WORKERS=2

TRUSTED_HOSTS=localhost,127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1